<?xml version="1.0" encoding="utf-8"?>
<!--
  Trust for this app only.

  system  keeps the normal public CAs, so nothing breaks if you later put a
          real certificate in front of the middleware.
  @raw/unifi_toggle_ca is the CA generated by scripts/make-cert.sh on the VM.
          Replace res/raw/unifi_toggle_ca.pem with your own ca.crt.

  Cleartext is off. The widget only ever speaks HTTPS.

  This is a base-config rather than a per domain block on purpose. The app
  talks to exactly one URL, the one in Config.kt, so there is no second place
  to keep the host name in sync.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/unifi_toggle_ca" />
        </trust-anchors>
    </base-config>
</network-security-config>
