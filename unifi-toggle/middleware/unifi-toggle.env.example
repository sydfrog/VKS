# Copy to /etc/unifi-toggle/unifi-toggle.env, fill in, then:
#   sudo chown root:unifi-toggle /etc/unifi-toggle/unifi-toggle.env
#   sudo chmod 0640 /etc/unifi-toggle/unifi-toggle.env
#
# systemd reads this file directly. Do not put spaces around the equals sign.
# Wrap a value in double quotes if it contains spaces, as UNIFI_POLICY_NAME
# does below. systemd and the helper scripts both strip those quotes.

# ---------------------------------------------------------------- this service

# Shared secret the Android widget sends as "Authorization: Bearer <token>".
# Generate one with: scripts/gen-token.sh
API_TOKEN=replace-me-with-a-long-random-string

# Listen address and port. 0.0.0.0 means every interface on the VM.
BIND_HOST=0.0.0.0
PORT=8080

# TLS for the phone facing side. Generate with: scripts/make-cert.sh <vm-ip>
# Leave both blank to serve plain HTTP instead.
TLS_CERT_FILE=/etc/unifi-toggle/tls/server-fullchain.pem
TLS_KEY_FILE=/etc/unifi-toggle/tls/server.key

# info or debug
LOG_LEVEL=info

# ------------------------------------------------------------- UniFi console

# Your UCG Ultra address. Scheme is optional and defaults to https.
UNIFI_HOST=192.168.0.1

# unifi-os for a UCG Ultra or Cloud Key. network-server for a self hosted
# UniFi Network Application on port 8443.
UNIFI_CONTROLLER_TYPE=unifi-os

# Site name, not the display name. It is "default" unless you created more.
UNIFI_SITE=default

# Preferred credential. Create at Control Plane > Integrations > API Keys.
# An API key is not subject to the 2FA prompt on your Ubiquiti account.
UNIFI_API_KEY=replace-me-with-your-api-key

# Fallback only, and only for a local account that has 2FA disabled.
# Leave both blank when UNIFI_API_KEY is set.
UNIFI_USERNAME=
UNIFI_PASSWORD=

# auto picks the API key when present, otherwise username and password.
UNIFI_AUTH_MODE=auto

# A UCG Ultra presents a self signed certificate, so this is false by default.
# Set to a CA bundle path if you have replaced the console certificate.
UNIFI_VERIFY_SSL=false

# Seconds to wait on the console before giving up.
UNIFI_TIMEOUT=10

# ------------------------------------------------------------------ policy
#
# Point the service at exactly one policy, either by name or by ID.

# By name, spelled as it reads in the UniFi UI. Case and surrounding spaces do
# not matter. This is the quickest way to get running. If two policies share a
# name the service refuses to guess and tells you to use the ID instead.
UNIFI_POLICY_NAME="Block Kids from Internet"

# By ID, which keeps working if you rename the policy in the UI. Get it from
# scripts/probe-unifi.sh. When this is set, UNIFI_POLICY_NAME is ignored.
UNIFI_POLICY_ID=

# auto probes firewall-policy, then traffic-rule, then firewall-rule.
# Pin it once you know which one you have, to save two lookups per call.
UNIFI_POLICY_KIND=auto
